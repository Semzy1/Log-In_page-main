# Environment Configuration
# Copy this file to .env and fill in the actual values
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/shopease

# JWT Configuration
# Generate secure secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=1h
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-this-in-production
JWT_REFRESH_EXPIRE=7d

# Email Configuration (Gmail SMTP)
# For Gmail, use an App Password (not your regular password)
# Generate here: https://myaccount.google.com/apppasswords
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password
NOTIFY_EMAIL=admin@shopease.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Payment Gateway Keys
# Flutterwave (https://flutterwave.com)
FLUTTERWAVE_PUBLIC_KEY=pk_test_your-flutterwave-public-key
FLUTTERWAVE_SECRET_KEY=sk_test_your-flutterwave-secret-key

# Paystack (https://paystack.com)
PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key

# Admin Email
ADMIN_EMAIL=admin@shopease.com

# Logging
LOG_LEVEL=debug

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
