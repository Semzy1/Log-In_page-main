# ShopEase Environment Configuration Template
# Copy this file to `.env` and fill in your actual values
# NEVER commit .env to version control

# ============================================
# Application
# ============================================
NODE_ENV=development
PORT=5000

# ============================================
# Database
# ============================================
MONGODB_URI=mongodb://localhost:27017/shopease
MONGODB_TEST_URI=mongodb://localhost:27017/shopease-test

# ============================================
# Authentication & Security
# ============================================
# Generate secure random strings for these (use `openssl rand -hex 32`)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this-in-production
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=7d

# ============================================
# CORS & Frontend
# ============================================
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_PROD=https://shopease.example.com

# ============================================
# Email Service
# ============================================
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
NOTIFY_EMAIL=soluwasemiloba@gmail.com

# ============================================
# Payment Gateways
# ============================================
# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_SECRET_HASH=your-flutterwave-secret-hash

# Paystack
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# PayPal (optional)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# ============================================
# Stripe (optional for future use)
# ============================================
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# ============================================
# AWS S3 (optional for image uploads)
# ============================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=shopease-uploads
AWS_S3_REGION=us-east-1

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
LOG_FILE=logs/shopease.log

# ============================================
# Analytics (optional)
# ============================================
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# ============================================
# Security Headers
# ============================================
# Set to 'production' to enable strict security headers
ENVIRONMENT=development
